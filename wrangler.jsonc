{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cadence",
  "compatibility_date": "2026-07-15",
  "main": "worker/index.js",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GH_REPO": "StudioDavidPreli/cadence"
  }
  // The export/import event counter's store (worker/index.js handleEvent).
  // TEMPORARILY DISABLED, 2026-08-15: the Workers build deploys this config,
  // and the deploy rejected this binding twice (build baf96e93, then a clean
  // retry), while the same tree deploys green without it. The build log is
  // dashboard-only, but the likely cause is Analytics Engine needing a
  // one-time enablement on the account. Without the binding the endpoint
  // still answers 204 and counts nothing (handleEvent catches the missing
  // binding and console.errors, visible in live logs). Once the dashboard
  // side is settled, uncomment this block and push; the dataset then creates
  // itself on the first write. Full story and the read-side queries:
  // docs/decisions/event-counter-2026-08-15.md.
  // "analytics_engine_datasets": [
  //   {
  //     "binding": "EVENTS",
  //     "dataset": "cadence_events"
  //   }
  // ]
}
