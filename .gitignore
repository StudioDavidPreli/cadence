# Dependencies
node_modules/

# Build output
dist/

# Cloudflare Worker: local secrets + wrangler state are gitignored in the
# "wrangler files" block below. GH_TOKEN lives in the Workers dashboard as a
# secret; GH_REPO is a plaintext var in wrangler.jsonc.

# Playwright MCP capture artifacts (per-session, not for repo)
.playwright-mcp/

# macOS
.DS_Store
docs/.DS_Store

# Working artifacts guard: the loose working files that used to be listed here
# (drafts, recordings, local references) moved into archive/ 2026-07-28, which
# the /archive/ rule below already covers. The mp4 rule stays as a guard against
# new screen captures landing in the tree.
*.mp4

# Python bytecode cache
__pycache__/

# Archived motion-tile probes and superseded assets — kept locally for reference,
# out of the build. Restore by moving a path back to its original src/ or public/ spot.
/archive/

# Local-only files kept on disk but out of git: the vendored emil-design-eng skill
# (and its lockfile). Not build inputs: Cloudflare deploys the static build (dist/)
# plus the Worker (worker/index.js, per wrangler.jsonc), and none of these files are
# part of either.
/skills-lock.json
.claude/skills/
.agents/skills/

# Untracked 2026-07-21 for the repo-public prep (David's call): the instructions
# file and the tracker are working files, not site function, and they carry
# personal material. HISTORY NOTE: CLAUDE.md was lost once while gitignored and
# recovered from git (2026-07-15). The safety net now is dated backup copies in
# archive/savedinstructions/; refresh them whenever either file changes shape.
CLAUDE.md
/tracker/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Playwright test-run artifacts (traces, error contexts); the suite itself is e2e/
test-results/
playwright-report/
