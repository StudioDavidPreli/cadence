# Dependencies
node_modules/

# Build output
dist/

# Cloudflare Worker local secrets (GH_TOKEN, GH_REPO) — never committed.
# GH_TOKEN's real value lives in the Workers dashboard as a secret; GH_REPO is a
# plaintext var in wrangler.jsonc.
.dev.vars

# Local state from `wrangler dev` — regenerated per run, not a build input.
.wrangler/

# Local references (not for repo)
docs/references/animation-principles/

# Playwright MCP capture artifacts (per-session, not for repo)
.playwright-mcp/

# macOS
.DS_Store
docs/.DS_Store

# Working artifacts — backed up externally, not needed for the app to build or run
componentSummary-drafts.txt
docs/browser-project/
docs/cover-letter-reference.md
docs/recordings/current-2026-05-04/
docs/recordings/breakpointLayout.jpg
*.mp4

# Python bytecode cache
__pycache__/

# Archived motion-tile probes and superseded assets — kept locally for reference,
# out of the build. Restore by moving a path back to its original src/ or public/ spot.
/archive/

# Local-only files kept on disk but out of git: project instructions, the vendored
# emil-design-eng skill (and its lockfile). Not build inputs: Cloudflare deploys
# the static build (dist/) plus the Worker (worker/index.js, per wrangler.jsonc),
# and none of these files are part of either.
/CLAUDE.md
/skills-lock.json
.claude/skills/
.agents/skills/
